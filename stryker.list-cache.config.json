{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "concurrency": 2,
  "incremental": false,
  "mutate": [
    "src/runtime/list-text.ts:137:0-148:0",
    "src/runtime/list-text.ts:251:0-255:0",
    "src/runtime/list-text.ts:271:0-276:0",
    "src/runtime/list-text.ts:466:0-478:0",
    "src/runtime/list.ts:331:0-342:0",
    "src/runtime/list.ts:549:0-553:0",
    "src/runtime/list.ts:574:0-580:0",
    "src/runtime/list.ts:1009:0-1023:0"
  ],
  "plugins": ["./node_modules/@stryker-mutator/vitest-runner/dist/src/index.js"],
  "reporters": ["clear-text", "json"],
  "jsonReporter": { "fileName": "reports/mutation/list-cache/mutation.json" },
  "testRunner": "vitest",
  "thresholds": { "high": 80, "low": 60, "break": null },
  "vitest": { "configFile": "vitest.list-performance-mutation.config.ts", "related": true },
  "ignorePatterns": ["docs.local", "tests/browser/generated", "test-results", "benchmark", ".worktree"]
}
