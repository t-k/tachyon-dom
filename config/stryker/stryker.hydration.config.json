{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "concurrency": 2,
  "htmlReporter": {
    "fileName": "reports/mutation/hydration/index.html"
  },
  "incremental": false,
  "incrementalFile": "reports/mutation/incremental.json",
  "jsonReporter": {
    "fileName": "reports/mutation/hydration/mutation.json"
  },
  "mutate": [
    "src/runtime/conditional.ts:555:0-572:0",
    "src/runtime/conditional.ts:665:0-885:0",
    "src/runtime/list.ts:841:0-925:0",
    "src/compiler/targets/client.ts:736:0-750:0",
    "src/compiler/targets/client.ts:1058:0-1076:0",
    "src/compiler/sfc.ts:465:0-493:0",
    "src/compiler/sfc.ts:81:0-161:0",
    "src/compiler/sfc.ts:798:0-842:0",
    "src/compiler/sfc.ts:896:0-918:0"
  ],
  "plugins": [
    "./node_modules/@stryker-mutator/vitest-runner/dist/src/index.js"
  ],
  "reporters": [
    "clear-text",
    "html",
    "json"
  ],
  "testRunner": "vitest",
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "vitest": {
    "configFile": "config/vitest/vitest.hydration-mutation.config.ts",
    "related": true
  },
  "ignorePatterns": [
    "docs.local",
    "tests/browser/generated",
    "test-results",
    "benchmark",
    ".worktree"
  ]
}
