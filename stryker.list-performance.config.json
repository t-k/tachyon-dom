{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "concurrency": 2,
  "incremental": false,
  "mutate": [
    "src/runtime/list-core.ts:248:0-330:0",
    "src/runtime/list-text.ts:315:0-338:0",
    "src/runtime/list-text.ts:360:0-410:0",
    "src/runtime/list-text.ts:498:0-512:0",
    "src/runtime/list.ts:670:0-715:0",
    "src/runtime/list.ts:816:0-843:0",
    "src/runtime/list.ts:1045:0-1060:0"
  ],
  "plugins": ["./node_modules/@stryker-mutator/vitest-runner/dist/src/index.js"],
  "reporters": ["clear-text", "json"],
  "jsonReporter": { "fileName": "reports/mutation/list-performance/mutation.json" },
  "testRunner": "vitest",
  "thresholds": { "high": 80, "low": 60, "break": null },
  "vitest": { "configFile": "vitest.list-performance-mutation.config.ts", "related": true },
  "ignorePatterns": ["docs.local", "tests/browser/generated", "test-results", "benchmark", ".worktree"]
}
