{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "concurrency": 2,
  "htmlReporter": {
    "fileName": "reports/mutation/sfc/index.html"
  },
  "incremental": false,
  "incrementalFile": "reports/mutation/incremental.json",
  "jsonReporter": {
    "fileName": "reports/mutation/sfc/mutation.json"
  },
  "mutate": [
    "src/compiler/sfc.ts:72:0-147:0",
    "src/compiler/sfc.ts:436:0-442:0",
    "src/compiler/sfc.ts:625:0-635:0",
    "src/compiler/sfc.ts:724:0-768:0",
    "src/compiler/sfc.ts:779:0-787:0"
  ],
  "plugins": ["./node_modules/@stryker-mutator/vitest-runner/dist/src/index.js"],
  "reporters": ["clear-text", "html", "json"],
  "testRunner": "vitest",
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "vitest": {
    "configFile": "vitest.sfc-mutation.config.ts",
    "related": false
  },
  "ignorePatterns": ["docs.local", "tests/browser/generated", "test-results", "benchmark", ".worktree"]
}
