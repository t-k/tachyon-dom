{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "concurrency": 2,
  "htmlReporter": {
    "fileName": "reports/mutation/hydration/index.html"
  },
  "incremental": false,
  "incrementalFile": "reports/mutation/incremental.json",
  "jsonReporter": {
    "fileName": "reports/mutation/hydration/mutation.json"
  },
  "mutate": [
    "src/runtime/conditional.ts:533:0-548:0",
    "src/runtime/conditional.ts:653:0-873:0",
    "src/runtime/list.ts:829:0-908:0",
    "src/compiler/targets/client.ts:643:0-657:0",
    "src/compiler/targets/client.ts:973:0-989:0",
    "src/compiler/sfc.ts:471:0-487:0",
    "src/compiler/sfc.ts:84:0-159:0",
    "src/compiler/sfc.ts:759:0-803:0",
    "src/compiler/sfc.ts:869:0-878:0"
  ],
  "plugins": [
    "./node_modules/@stryker-mutator/vitest-runner/dist/src/index.js"
  ],
  "reporters": [
    "clear-text",
    "html",
    "json"
  ],
  "testRunner": "vitest",
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "vitest": {
    "configFile": "vitest.hydration-mutation.config.ts",
    "related": true
  },
  "ignorePatterns": [
    "docs.local",
    "tests/browser/generated",
    "test-results",
    "benchmark",
    ".worktree"
  ]
}
