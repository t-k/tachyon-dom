{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "tachyon-dom": ["./src/index.ts"],
      "tachyon-dom/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "examples",
    "benchmark/js-framework-benchmark/src",
    "benchmark/local-compare",
    "benchmark/web-framework/*.ts",
    "benchmark/compiler",
    "tests"
  ]
}
