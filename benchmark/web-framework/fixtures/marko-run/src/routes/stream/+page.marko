<const/items=Array.from({ length: 80 }, (_, index) => `stream item ${index + 1}`)/>
<const/deferredItems=new Promise((resolve) => setTimeout(() => resolve(items), 20))/>
<main data-route="stream">
  <h1>Stream</h1>
  <p data-stream="shell">Shell</p>
  <await|resolvedItems| value=deferredItems>
    <section data-stream="done">
      <h2>Deferred payload</h2>
      <ul>
        <for|item| of=resolvedItems><li>${item}</li></for>
      </ul>
    </section>
  </await>
</main>
