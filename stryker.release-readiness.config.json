{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "concurrency": 2,
  "htmlReporter": {
    "fileName": "reports/mutation/release-readiness/index.html"
  },
  "incremental": false,
  "incrementalFile": "reports/mutation/incremental.json",
  "jsonReporter": {
    "fileName": "reports/mutation/release-readiness/mutation.json"
  },
  "mutate": [
    "src/runtime/store.ts",
    "src/compiler/sfc.ts:925:0-987:0",
    "src/compiler/targets/client.ts:1255:0-1268:0",
    "src/compiler/targets/client.ts:1332:0-1340:0",
    "src/compiler/targets/client.ts:1620:0-1629:0",
    "src/compiler/html-tree.ts:96:0-127:1"
  ],
  "plugins": [
    "./node_modules/@stryker-mutator/vitest-runner/dist/src/index.js"
  ],
  "reporters": [
    "clear-text",
    "html",
    "json"
  ],
  "testRunner": "vitest",
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "vitest": {
    "configFile": "vitest.release-readiness.config.ts",
    "related": false
  },
  "ignorePatterns": [
    "docs.local",
    "tests/browser/generated",
    "test-results",
    "benchmark",
    ".worktree"
  ]
}
