{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "concurrency": 4,
  "incremental": false,
  "mutate": ["src/runtime/store.ts"],
  "plugins": ["./node_modules/@stryker-mutator/vitest-runner/dist/src/index.js"],
  "reporters": ["clear-text"],
  "testRunner": "vitest",
  "thresholds": { "high": 80, "low": 60, "break": null },
  "vitest": { "configFile": "vitest.store-mutation.config.ts", "related": false },
  "ignorePatterns": ["docs.local", "tests/browser/generated", "test-results", "benchmark", ".worktree", "reports"]
}
